{
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Clide",
        "url": "index.html",
        "width": 1180,
        "height": 800,
        "minWidth": 940,
        "minHeight": 660,
        "resizable": true,
        "center": true,
        "visible": true
      },
      {
        "label": "hud",
        "url": "hud.html",
        "width": 340,
        "height": 56,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "focus": false,
        "focusable": false,
        "visible": false,
        "skipTaskbar": true
      }
    ]
  },
  "bundle": {
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "windows-runtime/*.dll": "./",
      "windows-runtime/NOTICE.txt": "NOTICE-Windows-runtime.txt"
    }
  }
}
